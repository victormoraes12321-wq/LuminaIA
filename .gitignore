# ======================================================================
# LuminaAI — Root .gitignore
# ======================================================================

# ── Environment & Secrets ──
.env
.env.*
*.env
!.env.example
!backend/.env.example
!frontend/.env.example
*.pem
*.key
*.cert
*.pfx
*.p12

# ── Python / Backend ──
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/.venv/
.venv/
venv/
ENV/
env/
.pytest_cache/
.coverage
htmlcov/
*.sqlite3
*.sqlite
*.db

# ── Node.js / Frontend ──
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
build/
frontend/build/
.turbo/
frontend/.turbo/
*.tsbuildinfo
next-env.d.ts
.vercel/

# ── Package Manager Logs ──
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Lumina Runtime Logs & Ephemeral Storage ──
runtime-logs/
*.log
.lumina_conversations/
scratch/
tmp/
temp/

# ── OS & Editor Artifacts ──
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
