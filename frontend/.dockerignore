# Build-only allowlist. Tests, reports, local dependencies and secrets never
# enter the Docker context; the final stage copies only built runtime assets.
**

!package.json
!package-lock.json
!app/
!app/**
!components/
!components/**
!context/
!context/**
!engines/
!engines/**
!hooks/
!hooks/**
!lib/
!lib/**
!public/
!public/**
!styles/
!styles/**
!types/
!types/**
!next.config.ts
!postcss.config.mjs
!proxy.ts
!tailwind.config.ts
!tsconfig.json

**/node_modules/
**/.next/
**/tests/
**/test-results/
**/playwright-report/
**/coverage/
**/.env
**/.env.*
**/*.log
**/*.tmp
