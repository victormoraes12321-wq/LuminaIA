# ================================================================
# LuminaAI — Variáveis de Ambiente do Frontend (Next.js)
# ----------------------------------------------------------------
# Copie este arquivo para .env.local (ou .env) e ajuste os valores.
# ================================================================

# URL base da API do backend FastAPI.
# ----------------------------------------------------------------
# - DESENVOLVIMENTO: Defina como a URL do seu backend local.
#   Exemplo: NEXT_PUBLIC_API_URL=http://localhost:8000
#
# - PRODUÇÃO: Deixe em branco (vazio) se o frontend e o backend
#   forem servidos sob o mesmo domínio através do proxy reverso Nginx.
#   Isso força o uso de URLs relativas (ex: /api/v1/query) e previne
#   bloqueios de Mixed Content (HTTPS misturado com HTTP) ou CORS no browser.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Rollout governado. Permanece desabilitado ate publicacao operacional aprovada.
NEXT_PUBLIC_SEMANTIC_RETRIEVAL_ENABLED=false

# Prompts 21-24: server-controlled modes and ergonomic public mirrors.
# Production remains LEGACY_ONLY until an approved rollout changes both server and backend capabilities.
DASHBOARD_UI_MODE=LEGACY_ONLY
DASHBOARD_UI_PREVIEW_ALLOWLISTED=false
NEXT_PUBLIC_DASHBOARD_UI_MODE=LEGACY_ONLY
DASHBOARD_AI_ASSISTANCE_MODE=LEGACY_ONLY
NEXT_PUBLIC_DASHBOARD_AI_ASSISTANCE_MODE=LEGACY_ONLY
NEXT_PUBLIC_POST_SYNC_INSIGHTS_MODE=LEGACY_ONLY
NEXT_PUBLIC_POST_SYNC_INSIGHTS_APIS_ENABLED=false
NEXT_PUBLIC_POST_SYNC_INSIGHTS_FRONTEND_ENABLED=false
NEXT_PUBLIC_OBSERVABILITY_MODE=LEGACY_ONLY
NEXT_PUBLIC_OBSERVABILITY_APIS_ENABLED=false
NEXT_PUBLIC_OBSERVABILITY_FRONTEND_ENABLED=false
