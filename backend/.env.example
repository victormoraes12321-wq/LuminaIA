# ================================================================
# LuminaAI — Variáveis de Ambiente
# ----------------------------------------------------------------
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA versione o arquivo .env no repositório.
# ================================================================


# ── Aplicação ────────────────────────────────────────────────
APP_NAME=LuminaAI
APP_VERSION=1.0.0
ENVIRONMENT=development
# development | staging | production
DEBUG=false


# ── PostgreSQL ───────────────────────────────────────────────
# Formato obrigatório: postgresql+asyncpg://usuario:senha@host:porta/banco
DATABASE_URL=postgresql+asyncpg://luminaai_user:sua_senha_aqui@localhost:5432/luminaai_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600


# ── Segurança ────────────────────────────────────────────────
# Gere SECRET_KEY com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=SUBSTITUA_COM_OUTPUT_DO_COMANDO_ACIMA_MIN_32_CHARS

# Gere ENCRYPTION_KEY (Fernet) com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=SUBSTITUA_COM_OUTPUT_DO_COMANDO_ACIMA_BASE64

ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256


# ── OpenAI ───────────────────────────────────────────────────
# Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-SUBSTITUA_COM_SUA_CHAVE_OPENAI
OPENAI_MODEL=gpt-4o-2024-08-06
OPENAI_MAX_TOKENS=1024
OPENAI_TEMPERATURE=0.0
OPENAI_TIMEOUT=30


# ── CORS ─────────────────────────────────────────────────────
# Lista de origens permitidas para CORS (formato JSON array em string)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]
