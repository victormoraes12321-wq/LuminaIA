# LuminaAI safe environment template.
# Copy to .env locally. Never commit .env or replace required-secret placeholders here.

APP_NAME=LuminaAI
APP_VERSION=2.0.0
ENVIRONMENT=development
DEBUG=false

# Required connection and cryptographic secrets.
DATABASE_URL=<required-secret>
SECRET_KEY=<required-secret>
ENCRYPTION_KEY=<required-secret>
OPENAI_API_KEY=<required-secret>
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1024
OPENAI_TEMPERATURE=0.0
OPENAI_TIMEOUT=30

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256
CORS_ORIGINS=["http://localhost:3002"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# Prompt 19 is contract-only and has no runtime feature flag.
# Prompt 20 - governed dashboard backend (off by default).
DASHBOARD_BACKEND_MODE=LEGACY_ONLY
DASHBOARD_ADMIN_APIS_ENABLED=false
DASHBOARD_RUNTIME_APIS_ENABLED=false
DASHBOARD_PUBLISHING_ENABLED=false
DASHBOARD_ROLLBACK_ENABLED=false
DASHBOARD_COLLABORATORS_ENABLED=false
DASHBOARD_RUNTIME_CACHE_ENABLED=false
DASHBOARD_MATERIALIZATION_ENABLED=false
DASHBOARD_AUDIT_ENABLED=false
DASHBOARD_LEGACY_IMPORT_DRY_RUN_ENABLED=false
DASHBOARD_TENANT_ALLOWLIST=[]

# Prompt 22 - governed dashboard AI assistance (off by default).
DASHBOARD_AI_ASSISTANCE_MODE=LEGACY_ONLY
DASHBOARD_AI_APIS_ENABLED=false
DASHBOARD_AI_FRONTEND_ENABLED=false
DASHBOARD_AI_FAKE_PROVIDER_ENABLED=false
DASHBOARD_AI_FEEDBACK_ENABLED=false
DASHBOARD_AI_EVALUATIONS_ENABLED=false
DASHBOARD_AI_TENANT_ALLOWLIST=[]
DASHBOARD_AI_MAX_INPUT_CHARACTERS=4000
DASHBOARD_AI_MAX_OUTPUT_TOKENS=1200
DASHBOARD_AI_MAX_TOOL_CALLS=12
DASHBOARD_AI_MAX_DURATION_MS=15000

# Prompt 23 - post-sync insights (off by default).
POST_SYNC_INSIGHTS_MODE=LEGACY_ONLY
POST_SYNC_INSIGHTS_APIS_ENABLED=false
POST_SYNC_INSIGHTS_FRONTEND_ENABLED=false
POST_SYNC_INSIGHTS_OUTBOX_CONSUMER_ENABLED=false
POST_SYNC_INSIGHTS_AUTO_RUN_ENABLED=false
POST_SYNC_INSIGHTS_TENANT_ALLOWLIST=[]

# Prompt 24 - observability and evaluations (off by default).
OBSERVABILITY_MODE=LEGACY_ONLY
OBSERVABILITY_APIS_ENABLED=false
OBSERVABILITY_FRONTEND_ENABLED=false

# Prompt 25 - work queue and performance certification (off by default).
WORK_QUEUE_MODE=LEGACY_ONLY
WORK_QUEUE_APIS_ENABLED=false
WORK_QUEUE_FRONTEND_ENABLED=false
WORK_QUEUE_WORKER_ENABLED=false
WORK_QUEUE_MAX_CONCURRENCY=10
WORK_QUEUE_PER_TENANT_CONCURRENCY=3
WORK_QUEUE_LEASE_DURATION_SECONDS=60
WORK_QUEUE_HEARTBEAT_INTERVAL_SECONDS=15
WORK_QUEUE_TENANT_ALLOWLIST=[]
PERFORMANCE_CERTIFICATION_MODE=false

# Prompt 26 - security, migration and rollout (fail-closed baseline).
SECURITY_ROLLOUT_MODE=LEGACY_ONLY
SECURITY_ROLLOUT_APIS_ENABLED=false
ROLLOUT_EXECUTION_ENABLED=false
ROLLOUT_STAGE=DISABLED
ROLLOUT_CANARY_PERCENTAGE=0
ROLLOUT_CANARY_TENANT_ALLOWLIST=[]
V2_GLOBAL_EMERGENCY_DISABLE=true
KILL_SWITCH_DASHBOARD_V2_READ=true
KILL_SWITCH_DASHBOARD_V2_AUTHORING=true
KILL_SWITCH_DASHBOARD_AI=true
KILL_SWITCH_POST_SYNC_INSIGHTS=true
KILL_SWITCH_OBSERVABILITY_V2=true
KILL_SWITCH_EVALUATIONS_V2=true
KILL_SWITCH_WORK_QUEUE_V2=true
KILL_SWITCH_PERFORMANCE_CERTIFICATION=true
