{
  "additionalProperties": false,
  "properties": {
    "checksum": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Checksum",
      "type": "string"
    },
    "evaluation_id": {
      "format": "uuid",
      "title": "Evaluation Id",
      "type": "string"
    },
    "executed_at": {
      "format": "date-time",
      "title": "Executed At",
      "type": "string"
    },
    "rule_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 100,
      "title": "Rule Ids",
      "type": "array"
    },
    "status": {
      "enum": [
        "PASSED",
        "FAILED",
        "BLOCKED"
      ],
      "title": "Status",
      "type": "string"
    },
    "structural_match": {
      "title": "Structural Match",
      "type": "boolean"
    }
  },
  "required": [
    "evaluation_id",
    "status",
    "structural_match",
    "executed_at",
    "checksum"
  ],
  "title": "EvaluationResultV2",
  "type": "object"
}
