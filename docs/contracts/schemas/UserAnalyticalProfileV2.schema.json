      "title": "SavedReferencePreferenceV2",
      "type": "object"
    },
    "UserPreferenceItemV2": {
      "additionalProperties": false,
      "properties": {
        "checksum": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "consent": {
          "anyOf": [
            {
              "$ref": "#/$defs/PreferenceConsentV2"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "content": {
          "discriminator": {
            "mapping": {
              "ACCESSIBILITY": "#/$defs/AccessibilityPreferenceV2",
              "ANALYTICAL_DEFAULT": "#/$defs/AnalyticalDefaultPreferenceV2",
              "FAVORITE_DIMENSION": "#/$defs/FavoriteAssetPreferenceV2",
              "FAVORITE_ENTITY": "#/$defs/FavoriteAssetPreferenceV2",
              "FAVORITE_METRIC": "#/$defs/FavoriteAssetPreferenceV2",
              "INTERACTION": "#/$defs/InteractionPreferenceV2",
              "LOCALE": "#/$defs/LocalePreferenceV2",
              "PRESENTATION": "#/$defs/PresentationPreferenceV2",
              "PRIVACY": "#/$defs/PrivacyPreferenceV2",
              "RETENTION": "#/$defs/RetentionPreferenceV2",
              "SAVED_DASHBOARD_REFERENCE": "#/$defs/SavedReferencePreferenceV2",
              "SAVED_FILTER_REFERENCE": "#/$defs/SavedReferencePreferenceV2",
              "SAVED_QUERY_REFERENCE": "#/$defs/SavedReferencePreferenceV2"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/PresentationPreferenceV2"
            },
            {
              "$ref": "#/$defs/LocalePreferenceV2"
            },
            {
              "$ref": "#/$defs/AccessibilityPreferenceV2"
            },
            {
              "$ref": "#/$defs/AnalyticalDefaultPreferenceV2"
            },
            {
              "$ref": "#/$defs/FavoriteAssetPreferenceV2"
            },
            {
              "$ref": "#/$defs/SavedReferencePreferenceV2"
            },
            {
              "$ref": "#/$defs/InteractionPreferenceV2"
            },
            {
              "$ref": "#/$defs/PrivacyPreferenceV2"
            },
            {
              "$ref": "#/$defs/RetentionPreferenceV2"
            }
          ],
          "title": "Content"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "deleted_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deleted At"
        },
        "effective_from": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective From"
        },
        "effective_to": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective To"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "lock_version": {
          "minimum": 0,
          "title": "Lock Version",
          "type": "integer"
        },
        "origin": {
          "$ref": "#/$defs/PreferenceOriginV2"
        },
        "preference_id": {
          "format": "uuid",
          "title": "Preference Id",
          "type": "string"
        },
        "preference_key": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Preference Key",
          "type": "string"
        },
        "preference_type": {
          "$ref": "#/$defs/UserPreferenceType"
        },
        "profile_id": {
          "format": "uuid",
          "title": "Profile Id",
          "type": "string"
        },
        "risk": {
          "$ref": "#/$defs/PreferenceRisk"
        },
        "schema_version": {
          "default": "lumina.user-analytical-profile/1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/PreferenceStatus"
        },
        "tenant_id": {
          "format": "uuid",
          "title": "Tenant Id",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "user_id": {
          "format": "uuid",
          "title": "User Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "preference_id",
        "profile_id",
        "tenant_id",
        "user_id",
        "preference_type",
        "preference_key",
        "content",
        "risk",
        "origin",
        "status",
        "version",
        "lock_version",
        "checksum",
        "created_at",
        "updated_at"
      ],
      "title": "UserPreferenceItemV2",
      "type": "object"
    },
