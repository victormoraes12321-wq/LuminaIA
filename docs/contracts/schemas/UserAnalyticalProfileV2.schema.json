{
  "$defs": {
    "AccessibilityPreferenceV2": {
      "additionalProperties": false,
      "properties": {
        "accessible_labels": {
          "default": true,
          "title": "Accessible Labels",
          "type": "boolean"
        },
        "high_contrast": {
          "default": false,
          "title": "High Contrast",
          "type": "boolean"
        },
        "kind": {
          "const": "ACCESSIBILITY",
          "default": "ACCESSIBILITY",
          "title": "Kind",
          "type": "string"
        },
        "larger_text": {
          "default": false,
          "title": "Larger Text",
          "type": "boolean"
        },
        "reduced_motion": {
          "default": false,
          "title": "Reduced Motion",
          "type": "boolean"
        }
      },
      "title": "AccessibilityPreferenceV2",
      "type": "object"
    },
    "AnalyticalDefaultPreferenceV2": {
      "additionalProperties": false,
      "properties": {
        "canonical_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Canonical Id",
          "type": "string"
        },
        "display_label": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Display Label",
          "type": "string"
        },
        "filter_field_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Filter Field Id"
        },
        "filter_operator": {
          "anyOf": [
            {
              "enum": [
                "EQ",
                "IN"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Filter Operator"
        },
        "filter_values": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "maxItems": 100,
          "title": "Filter Values",
          "type": "array"
        },
        "kind": {
          "const": "ANALYTICAL_DEFAULT",
          "default": "ANALYTICAL_DEFAULT",
          "title": "Kind",
          "type": "string"
        },
        "knowledge_asset_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Knowledge Asset Id"
        },
        "limit": {
          "anyOf": [
            {
              "maximum": 1000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit"
        },
        "period_key": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Period Key"
        },
        "target_field": {
          "enum": [
            "metric",
            "dimension",
            "entity",
            "filter",
            "period",
            "ordering",
            "limit"
          ],
          "title": "Target Field",
          "type": "string"
        }
      },
      "required": [
        "target_field",
        "canonical_id",
        "display_label"
      ],
      "title": "AnalyticalDefaultPreferenceV2",
      "type": "object"
    },
    "ConsentStatus": {
      "enum": [
        "GRANTED",
        "REVOKED",
        "NOT_REQUIRED",
        "MISSING"
      ],
      "title": "ConsentStatus",
      "type": "string"
    },
    "FavoriteAssetPreferenceV2": {
      "additionalProperties": false,
      "properties": {
        "canonical_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Canonical Id",
          "type": "string"
        },
        "display_label": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Display Label",
          "type": "string"
        },
        "kind": {
          "enum": [
            "FAVORITE_METRIC",
            "FAVORITE_DIMENSION",
            "FAVORITE_ENTITY"
          ],
          "title": "Kind",
          "type": "string"
        },
        "knowledge_asset_id": {
          "format": "uuid",
          "title": "Knowledge Asset Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "canonical_id",
        "display_label",
        "knowledge_asset_id"
      ],
      "title": "FavoriteAssetPreferenceV2",
      "type": "object"
    },
    "InteractionPreferenceV2": {
      "additionalProperties": false,
      "properties": {
        "confirmation_level": {
          "default": "STANDARD",
          "enum": [
            "MINIMAL",
            "STANDARD",
            "STRICT"
          ],
          "title": "Confirmation Level",
          "type": "string"
        },
        "kind": {
          "const": "INTERACTION",
          "default": "INTERACTION",
          "title": "Kind",
          "type": "string"
        },
        "open_details_by_default": {
          "default": false,
          "title": "Open Details By Default",
          "type": "boolean"
        },
        "preserve_expanded_rows": {
          "default": false,
          "title": "Preserve Expanded Rows",
          "type": "boolean"
        }
      },
      "title": "InteractionPreferenceV2",
      "type": "object"
    },
    "LocalePreferenceV2": {
      "additionalProperties": false,
      "properties": {
        "currency_display": {
          "default": "BRL",
          "pattern": "^[A-Z]{3}$",
          "title": "Currency Display",
          "type": "string"
        },
        "date_format": {
          "default": "DD/MM/YYYY",
          "enum": [
            "DD/MM/YYYY",
            "YYYY-MM-DD",
            "DD MMM YYYY"
          ],
          "title": "Date Format",
          "type": "string"
        },
        "kind": {
          "const": "LOCALE",
          "default": "LOCALE",
          "title": "Kind",
          "type": "string"
        },
        "locale": {
          "default": "pt-BR",
          "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$",
          "title": "Locale",
          "type": "string"
        },
        "number_format": {
          "default": "pt-BR",
          "enum": [
            "pt-BR",
            "en-US"
          ],
          "title": "Number Format",
          "type": "string"
        },
        "timezone": {
          "default": "America/Sao_Paulo",
          "maxLength": 64,
          "minLength": 1,
          "title": "Timezone",
          "type": "string"
        }
      },
      "title": "LocalePreferenceV2",
      "type": "object"
    },
    "PreferenceConsentV2": {
      "additionalProperties": false,
      "properties": {
        "checksum": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "consent_id": {
          "format": "uuid",
          "title": "Consent Id",
          "type": "string"
        },
        "granted_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Granted At"
        },
        "lock_version": {
          "minimum": 0,
          "title": "Lock Version",
          "type": "integer"
        },
        "policy_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Policy Version",
          "type": "string"
        },
        "preference_id": {
          "format": "uuid",
          "title": "Preference Id",
          "type": "string"
        },
        "purpose": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "revoked_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revoked At"
        },
        "scope": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Scope",
          "type": "string"
        },
        "source": {
          "enum": [
            "USER_ACTION",
            "SYSTEM_PRESENTATION_SETTING"
          ],
          "title": "Source",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ConsentStatus"
        },
        "tenant_id": {
          "format": "uuid",
          "title": "Tenant Id",
          "type": "string"
        },
        "user_id": {
          "format": "uuid",
          "title": "User Id",
          "type": "string"
        }
      },
      "required": [
        "consent_id",
        "preference_id",
        "tenant_id",
        "user_id",
        "purpose",
        "scope",
        "status",
        "policy_version",
        "source",
        "lock_version",
        "checksum"
      ],
      "title": "PreferenceConsentV2",
      "type": "object"
    },
    "PreferenceOrigin": {
      "enum": [
        "USER_EXPLICIT",
        "SYSTEM_DEFAULT",
        "ADMIN_POLICY",
        "LEGACY_IMPORT",
        "MIGRATED",
        "FEEDBACK_CANDIDATE",
        "INFERRED_UNCONFIRMED"
      ],
      "title": "PreferenceOrigin",
      "type": "string"
    },
    "PreferenceOriginV2": {
      "additionalProperties": false,
      "properties": {
        "confirmed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confirmed At"
        },
        "kind": {
          "$ref": "#/$defs/PreferenceOrigin"
        },
        "source_label": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Source Label",
          "type": "string"
        },
        "source_reference": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Reference"
        }
      },
      "required": [
        "kind",
        "source_label"
      ],
      "title": "PreferenceOriginV2",
      "type": "object"
    },
    "PreferenceRisk": {
      "enum": [
        "SAFE_PRESENTATION",
        "VISIBLE_ANALYTICAL_DEFAULT",
        "REFERENCE_ONLY",
        "RESTRICTED",
        "FORBIDDEN"
      ],
      "title": "PreferenceRisk",
      "type": "string"
    },
    "PreferenceStatus": {
      "enum": [
        "ACTIVE",
        "DISABLED",
        "EXPIRED",
        "REVOKED",
        "DELETED",
        "PENDING_CONFIRMATION"
      ],
      "title": "PreferenceStatus",
      "type": "string"
    },
    "PresentationPreferenceV2": {
      "additionalProperties": false,
      "properties": {
        "chart_granularity": {
          "default": "AUTO",
