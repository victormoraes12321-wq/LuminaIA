      "enum": [
        "PRESENTATION",
        "LOCALE",
        "ACCESSIBILITY",
        "ANALYTICAL_DEFAULT",
        "FAVORITE_METRIC",
        "FAVORITE_DIMENSION",
        "FAVORITE_ENTITY",
        "SAVED_FILTER_REFERENCE",
        "SAVED_QUERY_REFERENCE",
        "SAVED_DASHBOARD_REFERENCE",
        "INTERACTION",
        "PRIVACY",
