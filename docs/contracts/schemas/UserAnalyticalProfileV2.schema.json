            "AUTO",
            "SUMMARY",
            "DETAILED"
          ],
          "title": "Chart Granularity",
          "type": "string"
        },
        "decimal_places": {
          "default": 2,
          "maximum": 8,
          "minimum": 0,
          "title": "Decimal Places",
          "type": "integer"
        },
        "kind": {
          "const": "PRESENTATION",
          "default": "PRESENTATION",
          "title": "Kind",
          "type": "string"
        },
        "ordering": {
          "default": "DEFAULT",
          "enum": [
            "DEFAULT",
            "ASCENDING",
            "DESCENDING"
          ],
          "title": "Ordering",
          "type": "string"
        },
        "page_size": {
          "default": 25,
          "maximum": 200,
          "minimum": 5,
          "title": "Page Size",
          "type": "integer"
        },
        "preferred_visualization": {
          "default": "AUTO",
          "enum": [
            "AUTO",
            "TABLE",
            "BAR_CHART",
            "LINE_CHART",
            "PIE_CHART",
            "KPI_CARD"
          ],
          "title": "Preferred Visualization",
          "type": "string"
        },
        "table_density": {
          "default": "COMFORTABLE",
          "enum": [
            "COMPACT",
            "COMFORTABLE",
            "SPACIOUS"
          ],
          "title": "Table Density",
          "type": "string"
        },
        "table_first": {
          "default": true,
          "title": "Table First",
          "type": "boolean"
        },
        "theme": {
          "default": "SYSTEM",
          "enum": [
            "SYSTEM",
            "LIGHT",
            "DARK"
          ],
          "title": "Theme",
          "type": "string"
        }
      },
      "title": "PresentationPreferenceV2",
      "type": "object"
    },
    "PrivacyPreferenceV2": {
      "additionalProperties": false,
      "properties": {
        "allow_legacy_import": {
          "default": false,
          "title": "Allow Legacy Import",
          "type": "boolean"
        },
        "application_audit_enabled": {
          "default": true,
          "title": "Application Audit Enabled",
          "type": "boolean"
        },
        "kind": {
          "const": "PRIVACY",
          "default": "PRIVACY",
          "title": "Kind",
          "type": "string"
        },
        "profile_enabled": {
          "default": true,
          "title": "Profile Enabled",
          "type": "boolean"
        }
      },
      "title": "PrivacyPreferenceV2",
      "type": "object"
    },
    "ProfileStatus": {
      "enum": [
        "ACTIVE",
        "DISABLED",
        "DELETION_PENDING",
        "DELETED"
      ],
      "title": "ProfileStatus",
      "type": "string"
    },
    "RetentionPreferenceV2": {
      "additionalProperties": false,
      "properties": {
        "deletion_request_days": {
          "default": 365,
          "maximum": 3650,
          "minimum": 30,
          "title": "Deletion Request Days",
          "type": "integer"
        },
        "expired_item_days": {
          "default": 90,
          "maximum": 3650,
          "minimum": 1,
          "title": "Expired Item Days",
          "type": "integer"
        },
        "export_days": {
          "default": 30,
          "maximum": 365,
          "minimum": 1,
          "title": "Export Days",
          "type": "integer"
        },
        "kind": {
          "const": "RETENTION",
          "default": "RETENTION",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "RetentionPreferenceV2",
      "type": "object"
    },
    "SavedReferencePreferenceV2": {
      "additionalProperties": false,
      "properties": {
        "canonical_scope": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Canonical Scope",
          "type": "string"
        },
        "display_label": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Display Label",
          "type": "string"
