{
  "$defs": {
    "KnowledgeAssetType": {
      "enum": [
        "BUSINESS_TERM",
        "METRIC",
        "KPI",
        "DIMENSION",
        "ENTITY",
        "BUSINESS_RULE",
        "ALIAS_SET",
        "CALENDAR_POLICY",
        "DATA_QUALITY_POLICY",
        "SEMANTIC_RELATION"
      ],
      "title": "KnowledgeAssetType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "asset_types": {
      "items": {
        "$ref": "#/$defs/KnowledgeAssetType"
      },
      "maxItems": 10,
      "title": "Asset Types",
      "type": "array"
    },
    "at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "At"
    },
    "cursor": {
      "anyOf": [
        {
          "maxLength": 512,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cursor"
    },
    "domains": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 20,
      "title": "Domains",
      "type": "array"
    },
    "limit": {
      "default": 20,
      "maximum": 100,
      "minimum": 1,
      "title": "Limit",
      "type": "integer"
    },
    "locale": {
      "default": "pt-BR",
      "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$",
      "title": "Locale",
      "type": "string"
    },
    "query": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Query",
      "type": "string"
    }
  },
  "required": [
    "query"
  ],
  "title": "KnowledgeSearchRequestV2",
  "type": "object"
}
