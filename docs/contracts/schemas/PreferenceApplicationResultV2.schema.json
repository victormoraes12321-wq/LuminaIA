          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/VisualizationKind"
        },
        "metric_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
