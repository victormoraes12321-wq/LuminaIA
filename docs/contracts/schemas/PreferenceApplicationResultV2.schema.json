            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Expression"
        },
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        },
        "timezone": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Timezone",
          "type": "string"
        },
        "window_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
