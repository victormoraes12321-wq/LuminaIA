{
  "$defs": {
    "EvaluationEvidenceV2": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "case_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Case Id",
          "type": "string"
        },
        "executed_at": {
          "format": "date-time",
          "title": "Executed At",
          "type": "string"
        },
        "duration_ms": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Duration Ms"
        },
        "sanitized_output_digest": {
          "maxLength": 128,
          "minLength": 8,
          "title": "Sanitized Output Digest",
          "type": "string"
        },
        "logs_digest": {
          "maxLength": 128,
          "minLength": 8,
          "title": "Logs Digest",
          "type": "string"
        },
        "checksum": {
          "maxLength": 128,
          "minLength": 8,
          "title": "Checksum",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "case_id",
        "executed_at",
        "duration_ms",
        "sanitized_output_digest",
        "logs_digest",
        "checksum"
      ],
      "title": "EvaluationEvidenceV2",
      "type": "object"
    },
    "EvaluationOutcomeV2": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "ERROR"
      ],
      "title": "EvaluationOutcomeV2",
      "type": "string"
    },
    "EvaluationRegressionV2": {
      "additionalProperties": false,
      "properties": {
        "regression_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Regression Id",
          "type": "string"
        },
        "case_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Case Id",
          "type": "string"
        },
        "suite": {
          "$ref": "#/$defs/EvaluationSuiteKindV2"
        },
        "regression_type": {
          "$ref": "#/$defs/RegressionTypeV2"
        },
        "description": {
          "maxLength": 256,
          "title": "Description",
          "type": "string"
        },
        "detected_at": {
          "format": "date-time",
          "title": "Detected At",
          "type": "string"
        },
        "baseline_checksum": {
          "maxLength": 128,
          "minLength": 8,
          "title": "Baseline Checksum",
          "type": "string"
        },
        "current_checksum": {
          "maxLength": 128,
          "minLength": 8,
          "title": "Current Checksum",
          "type": "string"
        }
      },
      "required": [
        "regression_id",
        "case_id",
        "suite",
        "regression_type",
        "description",
        "detected_at",
        "baseline_checksum",
        "current_checksum"
      ],
      "title": "EvaluationRegressionV2",
      "type": "object"
    },
    "EvaluationResultV2": {
      "additionalProperties": false,
      "properties": {
        "result_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Result Id",
          "type": "string"
        },
        "case_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Case Id",
          "type": "string"
        },
        "suite": {
          "$ref": "#/$defs/EvaluationSuiteKindV2"
        },
        "outcome": {
          "$ref": "#/$defs/EvaluationOutcomeV2"
        },
        "duration_ms": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Duration Ms"
        },
        "evidence": {
          "$ref": "#/$defs/EvaluationEvidenceV2"
        },
        "failure_reasons": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Failure Reasons",
          "type": "array"
        },
        "checksum": {
          "maxLength": 128,
          "minLength": 8,
          "title": "Checksum",
          "type": "string"
        }
      },
      "required": [
        "result_id",
        "case_id",
        "suite",
        "outcome",
        "duration_ms",
        "evidence",
        "checksum"
      ],
      "title": "EvaluationResultV2",
      "type": "object"
    },
    "EvaluationSuiteKindV2": {
      "enum": [
        "TEMPORAL_NORMALIZATION",
        "COMPARISON_PLANNER",
        "COMPARISON_EXECUTOR",
        "CONTEXT_RESOLUTION",
        "ENTERPRISE_KNOWLEDGE",
        "SEMANTIC_RETRIEVAL",
        "AI_TOOL_REGISTRY",
        "SAFE_ANALYTICAL_POSTGRESQL",
        "AI_ORCHESTRATION",
        "VALIDATION_PROVENANCE",
        "SMART_CACHE",
        "DASHBOARD_BLUEPRINT",
        "DASHBOARD_BACKEND",
        "DASHBOARD_UI",
        "DASHBOARD_AI",
        "POST_SYNC_INSIGHTS",
        "TENANT_ISOLATION",
        "SECURITY",
        "REPRODUCIBILITY"
      ],
      "title": "EvaluationSuiteKindV2",
      "type": "string"
    },
    "RegressionTypeV2": {
      "enum": [
        "NEW_FAIL",
        "PASS_TO_FAIL",
        "SECURITY_INVARIANT_VIOLATION",
        "TENANT_LEAKAGE",
        "REPRODUCIBILITY_DIVERGENCE",
        "SCHEMA_DIVERGENCE",
        "UNSAFE_ACTION_ACCEPTED",
        "CANONICAL_RESOLUTION_DEGRADATION",
        "NEW_XFAIL_SKIP_MARKER",
        "UNEXPECTED_OPENAPI_CHANGE"
      ],
      "title": "RegressionTypeV2",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "suite": {
      "$ref": "#/$defs/EvaluationSuiteKindV2"
    },
    "executed_at": {
      "format": "date-time",
      "title": "Executed At",
      "type": "string"
    },
    "total_cases": {
      "minimum": 0,
      "title": "Total Cases",
      "type": "integer"
    },
    "passed_cases": {
      "minimum": 0,
      "title": "Passed Cases",
      "type": "integer"
    },
    "failed_cases": {
      "minimum": 0,
      "title": "Failed Cases",
      "type": "integer"
    },
    "blocked_cases": {
      "minimum": 0,
      "title": "Blocked Cases",
      "type": "integer"
    },
    "error_cases": {
      "minimum": 0,
      "title": "Error Cases",
      "type": "integer"
    },
    "duration_ms": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "string"
        }
      ],
      "title": "Duration Ms"
    },
    "results": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EvaluationResultV2"
      },
      "title": "Results",
      "type": "array"
    },
    "regressions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EvaluationRegressionV2"
      },
      "title": "Regressions",
      "type": "array"
    },
    "checksum": {
      "maxLength": 128,
      "minLength": 8,
      "title": "Checksum",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "suite",
    "executed_at",
    "total_cases",
    "passed_cases",
    "failed_cases",
    "blocked_cases",
    "error_cases",
    "duration_ms",
    "checksum"
  ],
  "title": "EvaluationRunV2",
  "type": "object"
}
