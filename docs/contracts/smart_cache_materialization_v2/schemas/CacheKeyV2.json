{
  "$defs": {
    "CacheKeyComponentV2": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
            "presentation_policy_fingerprint",
            "compiler_options_fingerprint",
            "locale_fingerprint"
          ],
          "title": "Name",
          "type": "string"
        },
        "value": {
          "maxLength": 128,
          "minLength": 16,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "CacheKeyComponentV2",
      "type": "object"
    },
    "CacheType": {
      "enum": [
        "METADATA",
        "CONTRACT_SCHEMA",
        "POLICY",
        "TOOL_CATALOG",
        "ANALYTICAL_CATALOG",
        "SEMANTIC_METADATA",
        "COMPILED_PLAN",
        "CERTIFIED_ANALYTICAL_RESULT",
        "CERTIFICATION_ENVELOPE",
        "PUBLIC_PROVENANCE",
        "DETERMINISTIC_PRESENTATION",
        "NEGATIVE_METADATA",
        "FORBIDDEN"
      ],
      "title": "CacheType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "analytical_catalog_version": {
      "title": "Analytical Catalog Version",
      "type": "string"
    },
    "cache_type": {
      "$ref": "#/$defs/CacheType"
    },
    "canonical_period_fingerprint": {
      "title": "Canonical Period Fingerprint",
      "type": "string"
    },
    "canonical_query_fingerprint": {
      "title": "Canonical Query Fingerprint",
      "type": "string"
    },
    "certification_contract_version": {
      "title": "Certification Contract Version",
      "type": "string"
    },
    "compiler_version": {
      "title": "Compiler Version",
      "type": "string"
    },
    "components": {
      "items": {
        "$ref": "#/$defs/CacheKeyComponentV2"
      },
      "title": "Components",
      "type": "array"
    },
    "contract_version": {
      "default": "lumina.smart-cache-materialization/1.0",
      "title": "Contract Version",
      "type": "string"
    },
    "filter_structure_fingerprint": {
      "title": "Filter Structure Fingerprint",
      "type": "string"
    },
    "generation_counter": {
      "default": 1,
      "minimum": 0,
      "title": "Generation Counter",
      "type": "integer"
    },
    "generation_counters": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Generation Counters",
      "type": "object"
    },
    "metric_fingerprints": {
      "items": {
        "type": "string"
      },
      "title": "Metric Fingerprints",
      "type": "array"
    },
    "namespace": {
      "default": "lumina",
      "title": "Namespace",
      "type": "string"
    },
    "scope_fingerprint": {
      "title": "Scope Fingerprint",
      "type": "string"
    },
    "source_sync_version": {
      "title": "Source Sync Version",
      "type": "string"
    },
    "source_watermark": {
      "title": "Source Watermark",
      "type": "string"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    },
    "tenant_strategy": {
      "title": "Tenant Strategy",
      "type": "string"
    },
    "tool_registry_snapshot": {
      "title": "Tool Registry Snapshot",
      "type": "string"
    },
    "validation_policy_version": {
      "title": "Validation Policy Version",
      "type": "string"
    }
  },
  "required": [
    "cache_type",
    "tenant_id",
    "scope_fingerprint",
    "canonical_query_fingerprint",
    "analytical_catalog_version",
    "metric_fingerprints",
    "filter_structure_fingerprint",
    "canonical_period_fingerprint",
    "tenant_strategy",
    "source_sync_version",
    "source_watermark",
    "validation_policy_version",
    "certification_contract_version",
    "compiler_version",
    "tool_registry_snapshot"
  ],
  "title": "CacheKeyV2",
  "type": "object"
}
