          },
          "dry_run": {
            "title": "Dry Run",
            "type": "boolean"
          },
          "evicted_count": {
            "title": "Evicted Count",
            "type": "integer"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
