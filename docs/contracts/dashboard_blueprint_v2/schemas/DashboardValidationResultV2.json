{
  "$defs": {
    "DashboardCanonicalizationResultV2": {
      "additionalProperties": false,
      "properties": {
        "canonical_json": {
          "maxLength": 1000000,
          "minLength": 2,
          "title": "Canonical Json",
          "type": "string"
        },
        "checksums": {
          "$ref": "#/$defs/DashboardChecksumSetV2"
        },
        "contract_version": {
          "default": "lumina.dashboard-blueprint/2.0",
          "title": "Contract Version",
          "type": "string"
        }
      },
      "required": [
        "canonical_json",
        "checksums"
      ],
      "title": "DashboardCanonicalizationResultV2",
      "type": "object"
    },
    "DashboardChecksumSetV2": {
      "additionalProperties": false,
      "properties": {
        "accessibility_checksum": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Accessibility Checksum",
          "type": "string"
        },
        "bindings_checksum": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Bindings Checksum",
          "type": "string"
        },
        "blueprint_checksum": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Blueprint Checksum",
          "type": "string"
        },
        "filters_checksum": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Filters Checksum",
          "type": "string"
        },
        "interactions_checksum": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Interactions Checksum",
          "type": "string"
        },
        "layout_checksum": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Layout Checksum",
          "type": "string"
        },
        "semantic_checksum": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Semantic Checksum",
          "type": "string"
        },
        "visual_checksum": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Visual Checksum",
          "type": "string"
        },
        "widgets_checksum": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Widgets Checksum",
          "type": "string"
        }
      },
      "required": [
        "blueprint_checksum",
        "semantic_checksum",
        "visual_checksum",
        "layout_checksum",
        "widgets_checksum",
        "bindings_checksum",
        "filters_checksum",
        "interactions_checksum",
        "accessibility_checksum"
      ],
      "title": "DashboardChecksumSetV2",
      "type": "object"
    },
    "DashboardValidationIssueV2": {
      "additionalProperties": false,
      "properties": {
        "blocking": {
          "default": false,
          "title": "Blocking",
          "type": "boolean"
        },
        "code": {
          "pattern": "^[A-Z][A-Z0-9_]{2,79}$",
          "title": "Code",
          "type": "string"
        },
        "field_path": {
          "anyOf": [
            {
              "maxLength": 240,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field Path"
        },
        "message": {
          "maxLength": 500,
          "minLength": 3,
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/DashboardValidationSeverityV2"
        },
        "stage": {
          "$ref": "#/$defs/DashboardValidationStageV2"
        }
      },
      "required": [
        "code",
        "stage",
        "severity",
        "message"
      ],
      "title": "DashboardValidationIssueV2",
      "type": "object"
    },
    "DashboardValidationSeverityV2": {
      "enum": [
        "INFO",
        "WARNING",
        "ERROR",
        "CRITICAL"
      ],
      "title": "DashboardValidationSeverityV2",
      "type": "string"
    },
    "DashboardValidationStageV2": {
      "enum": [
        "CONTRACT",
        "IDENTITY",
        "VERSION",
        "LIFECYCLE",
        "SECURITY",
        "CLASSIFICATION",
        "PERMISSIONS",
        "LAYOUT",
        "WIDGETS",
        "DATA_BINDINGS",
        "FILTERS",
        "INTERACTIONS",
        "FORMATTING",
        "ACCESSIBILITY",
        "PROVENANCE",
        "COMPATIBILITY",
        "CANONICALIZATION"
      ],
      "title": "DashboardValidationStageV2",
      "type": "string"
    },
    "DashboardValidationStatusV2": {
      "enum": [
        "VALID",
        "VALID_WITH_WARNINGS",
        "INVALID",
        "BLOCKED",
        "UNSUPPORTED_VERSION"
      ],
      "title": "DashboardValidationStatusV2",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "canonicalization": {
      "anyOf": [
        {
          "$ref": "#/$defs/DashboardCanonicalizationResultV2"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "completed_stages": {
      "default": [],
      "items": {
        "$ref": "#/$defs/DashboardValidationStageV2"
      },
      "maxItems": 17,
      "title": "Completed Stages",
      "type": "array"
    },
    "issues": {
      "default": [],
      "items": {
        "$ref": "#/$defs/DashboardValidationIssueV2"
      },
      "maxItems": 256,
      "title": "Issues",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/DashboardValidationStatusV2"
    }
  },
  "required": [
    "status"
  ],
  "title": "DashboardValidationResultV2",
  "type": "object"
}
