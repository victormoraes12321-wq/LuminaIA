{
  "$defs": {
    "DashboardFilterDrivenPeriodBindingV2": {
      "additionalProperties": false,
      "properties": {
        "filter_id": {
          "pattern": "^[a-z][a-z0-9_.:-]{2,127}$",
          "title": "Filter Id",
          "type": "string"
        },
        "period_type": {
          "const": "FILTER_DRIVEN",
          "title": "Period Type",
          "type": "string"
        }
      },
      "required": [
        "period_type",
        "filter_id"
      ],
      "title": "DashboardFilterDrivenPeriodBindingV2",
      "type": "object"
    },
    "DashboardFixedPeriodBindingV2": {
      "additionalProperties": false,
      "properties": {
        "end_date": {
          "format": "date",
          "title": "End Date",
          "type": "string"
        },
        "period_id": {
          "pattern": "^[a-z][a-z0-9_.:-]{2,127}$",
          "title": "Period Id",
          "type": "string"
        },
        "period_type": {
          "const": "FIXED",
          "title": "Period Type",
          "type": "string"
        },
        "start_date": {
          "format": "date",
          "title": "Start Date",
          "type": "string"
        }
      },
      "required": [
        "period_type",
        "period_id",
        "start_date",
        "end_date"
      ],
      "title": "DashboardFixedPeriodBindingV2",
      "type": "object"
    },
    "DashboardInheritedPeriodBindingV2": {
      "additionalProperties": false,
      "properties": {
        "period_type": {
          "const": "INHERITED_DASHBOARD",
          "title": "Period Type",
          "type": "string"
        },
        "source": {
          "const": "DASHBOARD_CONTEXT",
          "default": "DASHBOARD_CONTEXT",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "period_type"
      ],
      "title": "DashboardInheritedPeriodBindingV2",
      "type": "object"
    },
    "DashboardRelativePeriodBindingV2": {
      "additionalProperties": false,
      "properties": {
        "canonical_period_id": {
          "pattern": "^[a-z][a-z0-9_.:-]{2,127}$",
          "title": "Canonical Period Id",
          "type": "string"
        },
        "offset": {
          "default": 0,
          "maximum": 120,
          "minimum": -120,
          "title": "Offset",
          "type": "integer"
        },
        "period_type": {
          "const": "RELATIVE",
          "title": "Period Type",
          "type": "string"
        },
        "relation": {
          "enum": [
            "CURRENT",
            "PREVIOUS",
            "ROLLING",
            "TO_DATE"
          ],
          "title": "Relation",
          "type": "string"
        }
      },
      "required": [
        "period_type",
        "canonical_period_id",
        "relation"
      ],
      "title": "DashboardRelativePeriodBindingV2",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "FILTER_DRIVEN": "#/$defs/DashboardFilterDrivenPeriodBindingV2",
      "FIXED": "#/$defs/DashboardFixedPeriodBindingV2",
      "INHERITED_DASHBOARD": "#/$defs/DashboardInheritedPeriodBindingV2",
      "RELATIVE": "#/$defs/DashboardRelativePeriodBindingV2"
    },
    "propertyName": "period_type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/DashboardFixedPeriodBindingV2"
    },
    {
      "$ref": "#/$defs/DashboardRelativePeriodBindingV2"
    },
    {
      "$ref": "#/$defs/DashboardInheritedPeriodBindingV2"
    },
    {
      "$ref": "#/$defs/DashboardFilterDrivenPeriodBindingV2"
    }
  ]
}
