{
  "$defs": {
    "DashboardCachePreferenceV2": {
      "enum": [
        "CACHE_PREFERRED",
        "CACHE_BYPASS_PROHIBITED",
        "BACKEND_DECIDES"
      ],
      "title": "DashboardCachePreferenceV2",
      "type": "string"
    },
    "DashboardClassificationV2": {
      "enum": [
        "PUBLIC_METADATA",
        "TENANT_METADATA",
        "TENANT_BUSINESS_DATA",
        "RESTRICTED_BUSINESS_DATA",
        "PERSONAL_DATA",
        "SENSITIVE_PERSONAL_DATA",
        "SECRET",
        "FORBIDDEN"
      ],
      "title": "DashboardClassificationV2",
      "type": "string"
    },
    "DashboardComparisonBindingV2": {
      "additionalProperties": false,
      "properties": {
        "baseline_period": {
          "discriminator": {
            "mapping": {
              "FILTER_DRIVEN": "#/$defs/DashboardFilterDrivenPeriodBindingV2",
              "FIXED": "#/$defs/DashboardFixedPeriodBindingV2",
              "INHERITED_DASHBOARD": "#/$defs/DashboardInheritedPeriodBindingV2",
              "RELATIVE": "#/$defs/DashboardRelativePeriodBindingV2"
            },
            "propertyName": "period_type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/DashboardFixedPeriodBindingV2"
            },
            {
              "$ref": "#/$defs/DashboardRelativePeriodBindingV2"
            },
            {
              "$ref": "#/$defs/DashboardInheritedPeriodBindingV2"
            },
            {
              "$ref": "#/$defs/DashboardFilterDrivenPeriodBindingV2"
            }
          ],
          "title": "Baseline Period"
        },
        "current_period": {
          "discriminator": {
            "mapping": {
              "FILTER_DRIVEN": "#/$defs/DashboardFilterDrivenPeriodBindingV2",
              "FIXED": "#/$defs/DashboardFixedPeriodBindingV2",
              "INHERITED_DASHBOARD": "#/$defs/DashboardInheritedPeriodBindingV2",
              "RELATIVE": "#/$defs/DashboardRelativePeriodBindingV2"
            },
            "propertyName": "period_type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/DashboardFixedPeriodBindingV2"
            },
            {
              "$ref": "#/$defs/DashboardRelativePeriodBindingV2"
            },
            {
              "$ref": "#/$defs/DashboardInheritedPeriodBindingV2"
            },
            {
              "$ref": "#/$defs/DashboardFilterDrivenPeriodBindingV2"
            }
          ],
          "title": "Current Period"
        },
        "direction_semantics": {
          "default": "METRIC_REGISTRY",
          "enum": [
            "HIGHER_IS_BETTER",
            "LOWER_IS_BETTER",
            "NEUTRAL",
            "METRIC_REGISTRY"
          ],
          "title": "Direction Semantics",
          "type": "string"
        },
        "display_delta_absolute": {
          "default": true,
          "title": "Display Delta Absolute",
          "type": "boolean"
        },
        "display_percentage": {
          "default": true,
          "title": "Display Percentage",
          "type": "boolean"
        },
        "relationship": {
          "enum": [
            "PERIOD_OVER_PERIOD",
            "YEAR_OVER_YEAR",
            "ACTUAL_VS_TARGET",
            "ENTITY_VS_ENTITY"
          ],
          "title": "Relationship",
          "type": "string"
        },
        "zero_baseline_policy": {
          "default": "NOT_APPLICABLE",
          "enum": [
            "NOT_APPLICABLE",
            "ABSOLUTE_ONLY",
            "ERROR"
          ],
          "title": "Zero Baseline Policy",
          "type": "string"
        }
      },
      "required": [
        "current_period",
        "baseline_period",
        "relationship"
      ],
      "title": "DashboardComparisonBindingV2",
      "type": "object"
    },
    "DashboardCompletenessRequirementV2": {
      "enum": [
        "COMPLETE",
        "TRUNCATION_ALLOWED_WITH_NOTICE",
        "PARTIAL_ALLOWED_WITH_NOTICE"
      ],
      "title": "DashboardCompletenessRequirementV2",
      "type": "string"
    },
    "DashboardDimensionBindingV2": {
      "additionalProperties": false,
      "properties": {
        "dimension_id": {
          "pattern": "^[a-z][a-z0-9_.:-]{2,127}$",
          "title": "Dimension Id",
          "type": "string"
        },
        "display_label": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Display Label",
          "type": "string"
        },
        "drilldown_eligible": {
          "default": false,
          "title": "Drilldown Eligible",
          "type": "boolean"
        },
        "grouping_intent": {
          "enum": [
            "CATEGORY",
            "TIME_BUCKET",
            "HIERARCHY",
            "NONE"
          ],
          "title": "Grouping Intent",
          "type": "string"
        },
        "maximum_visual_cardinality": {
          "default": 20,
          "maximum": 250,
          "minimum": 1,
          "title": "Maximum Visual Cardinality",
          "type": "integer"
        },
        "null_handling": {
          "default": "PRESERVE",
          "enum": [
            "PRESERVE",
            "LABEL_UNKNOWN",
            "OMIT"
          ],
          "title": "Null Handling",
          "type": "string"
        },
        "sorting_intent": {
          "enum": [
            "ASC",
            "DESC",
            "METRIC_ASC",
            "METRIC_DESC",
            "NONE"
          ],
          "title": "Sorting Intent",
          "type": "string"
        }
      },
      "required": [
        "dimension_id",
        "display_label",
        "grouping_intent",
        "sorting_intent"
      ],
      "title": "DashboardDimensionBindingV2",
      "type": "object"
    },
    "DashboardEntityBindingV2": {
      "additionalProperties": false,
      "properties": {
        "canonical_entity_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Canonical Entity Ids",
          "type": "array"
        },
        "entity_type_id": {
          "pattern": "^[a-z][a-z0-9_.:-]{2,127}$",
          "title": "Entity Type Id",
          "type": "string"
        }
      },
      "required": [
        "entity_type_id"
      ],
      "title": "DashboardEntityBindingV2",
      "type": "object"
    },
    "DashboardFilterBindingV2": {
      "additionalProperties": false,
      "properties": {
        "filter_id": {
          "pattern": "^[a-z][a-z0-9_.:-]{2,127}$",
          "title": "Filter Id",
          "type": "string"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "target_id": {
          "pattern": "^[a-z][a-z0-9_.:-]{2,127}$",
          "title": "Target Id",
          "type": "string"
        }
      },
      "required": [
        "filter_id",
        "target_id"
      ],
      "title": "DashboardFilterBindingV2",
      "type": "object"
    },
    "DashboardFilterDrivenPeriodBindingV2": {
      "additionalProperties": false,
      "properties": {
        "filter_id": {
          "pattern": "^[a-z][a-z0-9_.:-]{2,127}$",
          "title": "Filter Id",
          "type": "string"
        },
        "period_type": {
          "const": "FILTER_DRIVEN",
          "title": "Period Type",
          "type": "string"
        }
      },
      "required": [
        "period_type",
        "filter_id"
      ],
      "title": "DashboardFilterDrivenPeriodBindingV2",
      "type": "object"
    },
    "DashboardFixedPeriodBindingV2": {
      "additionalProperties": false,
      "properties": {
        "end_date": {
          "format": "date",
          "title": "End Date",
          "type": "string"
        },
        "period_id": {
          "pattern": "^[a-z][a-z0-9_.:-]{2,127}$",
          "title": "Period Id",
          "type": "string"
        },
        "period_type": {
          "const": "FIXED",
          "title": "Period Type",
          "type": "string"
        },
        "start_date": {
          "format": "date",
          "title": "Start Date",
          "type": "string"
        }
      },
      "required": [
        "period_type",
        "period_id",
        "start_date",
        "end_date"
      ],
      "title": "DashboardFixedPeriodBindingV2",
      "type": "object"
    },
    "DashboardFreshnessRequirementV2": {
      "enum": [
        "FRESH",
        "STALE_WITH_NOTICE",
        "BACKEND_POLICY"
      ],
      "title": "DashboardFreshnessRequirementV2",
      "type": "string"
    },
    "DashboardInheritedPeriodBindingV2": {
      "additionalProperties": false,
      "properties": {
        "period_type": {
          "const": "INHERITED_DASHBOARD",
          "title": "Period Type",
          "type": "string"
        },
        "source": {
          "const": "DASHBOARD_CONTEXT",
          "default": "DASHBOARD_CONTEXT",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "period_type"
      ],
      "title": "DashboardInheritedPeriodBindingV2",
      "type": "object"
    },
    "DashboardMaterializationPreferenceV2": {
      "enum": [
        "MATERIALIZATION_PREFERRED",
        "MATERIALIZATION_REQUIRED",
        "LIVE_QUERY_REQUIRED",
        "BACKEND_DECIDES"
      ],
      "title": "DashboardMaterializationPreferenceV2",
      "type": "string"
    },
    "DashboardMetricBindingV2": {
      "additionalProperties": false,
      "properties": {
        "display_alias": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Alias"
        },
        "expected_aggregation": {
          "enum": [
            "SUM",
            "AVERAGE",
            "COUNT",
            "MIN",
            "MAX",
            "NONE"
          ],
          "title": "Expected Aggregation",
          "type": "string"
        },
        "expected_fingerprint": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 8,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Fingerprint"
        },
        "expected_unit": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Expected Unit",
          "type": "string"
        },
        "metric_id": {
          "pattern": "^[a-z][a-z0-9_.:-]{2,127}$",
          "title": "Metric Id",
          "type": "string"
        },
        "metric_registry_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Metric Registry Version",
          "type": "string"
        }
      },
      "required": [
        "metric_id",
        "metric_registry_version",
        "expected_unit",
        "expected_aggregation"
      ],
      "title": "DashboardMetricBindingV2",
      "type": "object"
    },
    "DashboardProvenanceRequirementV2": {
      "additionalProperties": false,
      "properties": {
        "applied_filters_required": {
          "default": true,
          "title": "Applied Filters Required",
          "type": "boolean"
        },
        "cache_indicator_required": {
          "default": true,
          "title": "Cache Indicator Required",
          "type": "boolean"
        },
        "metric_definition_required": {
          "default": true,
          "title": "Metric Definition Required",
          "type": "boolean"
        },
        "public_summary_required": {
          "default": true,
          "title": "Public Summary Required",
          "type": "boolean"
        },
        "source_freshness_required": {
          "default": true,
          "title": "Source Freshness Required",
          "type": "boolean"
        },
        "validation_status_required": {
          "default": true,
          "title": "Validation Status Required",
          "type": "boolean"
        },
        "warnings_required": {
          "default": true,
          "title": "Warnings Required",
          "type": "boolean"
        }
      },
      "title": "DashboardProvenanceRequirementV2",
      "type": "object"
    },
    "DashboardRelativePeriodBindingV2": {
      "additionalProperties": false,
      "properties": {
        "canonical_period_id": {
          "pattern": "^[a-z][a-z0-9_.:-]{2,127}$",
          "title": "Canonical Period Id",
          "type": "string"
        },
        "offset": {
          "default": 0,
          "maximum": 120,
          "minimum": -120,
          "title": "Offset",
          "type": "integer"
        },
        "period_type": {
          "const": "RELATIVE",
          "title": "Period Type",
          "type": "string"
        },
        "relation": {
          "enum": [
            "CURRENT",
            "PREVIOUS",
            "ROLLING",
            "TO_DATE"
          ],
          "title": "Relation",
          "type": "string"
        }
      },
      "required": [
        "period_type",
        "canonical_period_id",
        "relation"
      ],
      "title": "DashboardRelativePeriodBindingV2",
      "type": "object"
    },
    "DashboardResultShapeV2": {
      "enum": [
        "SCALAR",
        "COMPARISON",
        "TIME_SERIES",
        "GROUPED_SERIES",
        "RANKING",
        "TABLE",
        "STATUS_SUMMARY",
        "FACT_SET"
      ],
      "title": "DashboardResultShapeV2",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "analytical_dataset_id": {
      "pattern": "^[a-z][a-z0-9_.:-]{2,127}$",
      "title": "Analytical Dataset Id",
      "type": "string"
    },
    "binding_id": {
      "pattern": "^[a-z][a-z0-9_.:-]{2,127}$",
      "title": "Binding Id",
      "type": "string"
    },
    "cache_preference": {
      "$ref": "#/$defs/DashboardCachePreferenceV2",
      "default": "BACKEND_DECIDES"
    },
    "classification": {
      "$ref": "#/$defs/DashboardClassificationV2",
      "default": "TENANT_BUSINESS_DATA"
    },
    "comparison": {
      "anyOf": [
        {
          "$ref": "#/$defs/DashboardComparisonBindingV2"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "completeness": {
      "$ref": "#/$defs/DashboardCompletenessRequirementV2",
      "default": "COMPLETE"
    },
    "dimensions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/DashboardDimensionBindingV2"
      },
      "maxItems": 12,
      "title": "Dimensions",
      "type": "array"
    },
    "entities": {
      "default": [],
      "items": {
        "$ref": "#/$defs/DashboardEntityBindingV2"
      },
      "maxItems": 12,
      "title": "Entities",
      "type": "array"
    },
    "expected_result_shape": {
      "$ref": "#/$defs/DashboardResultShapeV2"
    },
    "filters": {
      "default": [],
      "items": {
        "$ref": "#/$defs/DashboardFilterBindingV2"
      },
      "maxItems": 32,
      "title": "Filters",
      "type": "array"
    },
    "freshness": {
      "$ref": "#/$defs/DashboardFreshnessRequirementV2",
      "default": "BACKEND_POLICY"
    },
    "materialization_preference": {
      "$ref": "#/$defs/DashboardMaterializationPreferenceV2",
      "default": "BACKEND_DECIDES"
    },
    "metrics": {
      "default": [],
      "items": {
        "$ref": "#/$defs/DashboardMetricBindingV2"
      },
      "maxItems": 12,
      "title": "Metrics",
      "type": "array"
    },
    "period": {
      "discriminator": {
        "mapping": {
          "FILTER_DRIVEN": "#/$defs/DashboardFilterDrivenPeriodBindingV2",
          "FIXED": "#/$defs/DashboardFixedPeriodBindingV2",
          "INHERITED_DASHBOARD": "#/$defs/DashboardInheritedPeriodBindingV2",
          "RELATIVE": "#/$defs/DashboardRelativePeriodBindingV2"
        },
        "propertyName": "period_type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/DashboardFixedPeriodBindingV2"
        },
        {
          "$ref": "#/$defs/DashboardRelativePeriodBindingV2"
        },
        {
          "$ref": "#/$defs/DashboardInheritedPeriodBindingV2"
        },
        {
          "$ref": "#/$defs/DashboardFilterDrivenPeriodBindingV2"
        }
      ],
      "title": "Period"
    },
    "provenance": {
      "$ref": "#/$defs/DashboardProvenanceRequirementV2"
    }
  },
  "required": [
    "binding_id",
    "analytical_dataset_id",
    "period",
    "expected_result_shape"
  ],
  "title": "DashboardDataBindingV2",
  "type": "object"
}
