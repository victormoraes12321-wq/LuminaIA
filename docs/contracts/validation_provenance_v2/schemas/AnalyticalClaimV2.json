      "items": {
        "type": "string"
      },
      "title": "Fact References",
      "type": "array"
    },
    "metric_references": {
      "items": {
        "type": "string"
      },
      "title": "Metric References",
      "type": "array"
    },
    "origin": {
      "default": "MODEL_PROPOSED",
      "title": "Origin",
      "type": "string"
    },
    "period_references": {
      "items": {
        "type": "string"
      },
      "title": "Period References",
      "type": "array"
    },
    "qualifiers": {
      "items": {
        "type": "string"
      },
      "title": "Qualifiers",
      "type": "array"
    },
    "text": {
      "description": "Subsegment or text assertion",
      "title": "Text",
      "type": "string"
    }
