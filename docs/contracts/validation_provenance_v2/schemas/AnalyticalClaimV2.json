{
  "$defs": {
    "ClaimType": {
      "enum": [
        "NUMERIC",
        "COMPARATIVE",
        "TEMPORAL",
        "RANKING",
        "STATUS",
        "COMPLETENESS",
        "WARNING",
        "DESCRIPTIVE",
        "CLARIFICATION"
      ],
      "title": "ClaimType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "checksum": {
