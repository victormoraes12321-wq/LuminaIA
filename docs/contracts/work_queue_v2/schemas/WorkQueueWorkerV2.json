{
  "$defs": {
    "WorkQueueJobTypeV2": {
      "enum": [
        "POST_SYNC_INSIGHT_RUN",
        "MATERIALIZATION_BUILD",
        "MATERIALIZATION_REFRESH",
        "CACHE_REFRESH",
        "EVALUATION_RUN",
        "DASHBOARD_BACKGROUND_REFRESH",
        "ANALYTICAL_BACKGROUND_QUERY",
        "SYNC_POST_PROCESSING"
      ],
      "title": "WorkQueueJobTypeV2",
      "type": "string"
    },
    "WorkQueueWorkerStatusKindV2": {
      "enum": [
        "STARTING",
        "ACTIVE",
        "DRAINING",
        "STOPPED",
        "FAILED"
      ],
      "title": "WorkQueueWorkerStatusKindV2",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "worker_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Worker Id",
      "type": "string"
    },
    "hostname": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Hostname",
      "type": "string"
    },
    "process_id": {
      "minimum": 1,
      "title": "Process Id",
      "type": "integer"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "last_heartbeat_at": {
      "format": "date-time",
      "title": "Last Heartbeat At",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/WorkQueueWorkerStatusKindV2"
    },
    "supported_job_types": {
      "items": {
        "$ref": "#/$defs/WorkQueueJobTypeV2"
      },
      "title": "Supported Job Types",
      "type": "array"
    },
    "active_jobs_count": {
      "default": 0,
      "minimum": 0,
      "title": "Active Jobs Count",
      "type": "integer"
    }
  },
  "required": [
    "worker_id",
    "hostname",
    "process_id",
    "started_at",
    "last_heartbeat_at",
    "status",
    "supported_job_types"
  ],
  "title": "WorkQueueWorkerV2",
  "type": "object"
}
